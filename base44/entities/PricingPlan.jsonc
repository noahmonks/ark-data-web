{
  "name": "PricingPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price_monthly": {
      "type": "number"
    },
    "price_annual": {
      "type": "number"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlighted": {
      "type": "boolean",
      "default": false
    },
    "cta_text": {
      "type": "string",
      "default": "Get Started"
    },
    "cta_link": {
      "type": "string"
    },
    "who_its_for": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}